# ---------------------------------------------------------------- frontend --
# All optional. With none of these set the app uses Robinhood Chain's public
# RPC endpoints and reads whichever chain deployments.json has contracts for.

# Private RPC endpoints, if you would rather not use the public ones.
# NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=
# NEXT_PUBLIC_ROBINHOOD_RPC_URL=

# Which chain the app targets when no wallet is connected — the network it asks
# people to switch to and reads from. Defaults to Robinhood Chain, never to the
# local node, so this is REQUIRED for local development against `npm run chain`.
#   31337 = hardhat (local)   46630 = Robinhood testnet   4663 = mainnet
# NEXT_PUBLIC_DEFAULT_CHAIN_ID=31337

# ----------------------------------------------------------------- deploy ---
# Used by scripts/ only, never by the frontend.
#
# DEPLOYER_PRIVATE_KEY does NOT go in this file or in .env. It goes in
# `.env.deploy`, which `npm run deployer:new` creates for you:
#
#     npm run deployer:new
#
# The reason is not style. Next.js auto-loads .env and .env.local, and Turbopack
# copies whatever it loads into .next/cache — so a key placed in .env is written
# verbatim into a build directory that gets copied into Docker contexts and CI
# artifacts. Next.js does not recognise the name `.env.deploy`, so a key there
# never reaches the build at all.

# RPC_URL=https://rpc.testnet.chain.robinhood.com

# Divides every mint price. Defaults to 1 locally and 1000 everywhere else, so
# a testnet wallet with a fraction of an ETH can still buy the whole ladder.
# MINT_PRICE_DIVISOR=1000
